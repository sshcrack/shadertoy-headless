{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "shadertoy",
  "version": "2.0.1",
  "dependencies": [
    "fmt",
    "glew",
    "cpp-httplib",
    "ms-gsl",
    "magic-enum",
    "cpp-base64",
    "nlohmann-json",
    "stb",
    "openssl"
  ],
  "features": {
    "gui": {
      "description": "Dependencies for the interactive ShaderToy editor",
      "dependencies": [
        "glfw3",
        {
          "name": "hello-imgui",
          "features": [
            "glfw-binding",
            "opengl3-binding"
          ]
        },
        "nativefiledialog-extended",
        "imgui-node-editor"
      ]
    },
    "preview": {
      "description": "Dependencies for the hidden-window preview tool",
      "dependencies": [
        "glfw3"
      ]
    },
    "c-api": {
      "description": "Dependencies for the stable C ABI headless OpenGL context helper",
      "dependencies": [
        "glfw3"
      ]
    }
  },
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d"
}
