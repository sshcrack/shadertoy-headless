{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "shadertoy",
  "version": "2.2.5",
  "dependencies": [
    "fmt",
    {
      "name": "glad",
      "features": [
        "gl-api-43"
      ]
    },
    "cpp-httplib",
    "ms-gsl",
    "magic-enum",
    "cpp-base64",
    "nlohmann-json",
    "stb",
    "openssl"
  ],
  "features": {
    "gui": {
      "description": "Dependencies for the interactive ShaderToy editor",
      "dependencies": [
        "glfw3",
        "glew",
        {
          "name": "hello-imgui",
          "features": [
            "glfw-binding",
            "opengl3-binding"
          ]
        },
        "nativefiledialog-extended",
        "imgui-node-editor"
      ]
    },
    "preview": {
      "description": "Dependencies for the hidden-window preview tool",
      "dependencies": [
        "glfw3"
      ]
    },
    "c-api": {
      "description": "Dependencies for the stable C ABI offscreen OpenGL context helper",
      "dependencies": [
        {
          "name": "egl-registry",
          "platform": "linux"
        },
        {
          "name": "glfw3",
          "platform": "!linux"
        }
      ]
    }
  },
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d"
}
