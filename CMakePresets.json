{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "GUI + library",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "SHADERTOY_BUILD_GUI": "ON"
      },
      "generator": "Ninja"
    },
    {
      "name": "library",
      "displayName": "Standalone library only",
      "binaryDir": "${sourceDir}/build-lib",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "SHADERTOY_BUILD_GUI": "OFF"
      },
      "generator": "Ninja"
    },
    {
      "name": "preview",
      "displayName": "Library + deterministic preview tool",
      "binaryDir": "${sourceDir}/build-preview",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "SHADERTOY_BUILD_GUI": "OFF",
        "SHADERTOY_BUILD_PREVIEW_TOOL": "ON"
      },
      "generator": "Ninja"
    },
    {
      "name": "c-api",
      "displayName": "Library + stable C ABI",
      "binaryDir": "${sourceDir}/build-c-api",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "SHADERTOY_BUILD_GUI": "OFF",
        "SHADERTOY_BUILD_C_API": "ON"
      },
      "generator": "Ninja"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "library",
      "configurePreset": "library"
    },
    {
      "name": "preview",
      "configurePreset": "preview"
    },
    {
      "name": "c-api",
      "configurePreset": "c-api"
    }
  ],
  "testPresets": [
    {
      "name": "library",
      "configurePreset": "library",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
