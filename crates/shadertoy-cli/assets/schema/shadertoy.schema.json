{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "asset": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "format": {
      "description": "Project manifest format version. Version 1 is the only supported value.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "pass": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Pass"
      }
    },
    "preset": {
      "description": "Named quality/configuration presets applied on top of this manifest.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Preset"
      }
    },
    "project": {
      "$ref": "#/$defs/ProjectSection"
    },
    "render": {
      "$ref": "#/$defs/RenderSection",
      "default": {
        "fps": 60.0,
        "height": 720,
        "preview_time": 1.0,
        "width": 1280
      }
    },
    "shader": {
      "$ref": "#/$defs/ShaderSection",
      "default": {}
    },
    "test": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestCase"
      }
    },
    "uniform": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UniformDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "project",
    "pass"
  ],
  "$defs": {
    "Asset": {
      "type": "object",
      "properties": {
        "kind": {
          "description": "Asset decoder/layout selected for this file. Cubemap assets are horizontal six-face strips; volume assets use the ShaderToy 20-byte binary header documented by `shadertoy docs assets`.",
          "$ref": "#/$defs/AssetKind"
        },
        "name": {
          "description": "Unique asset name used by pass inputs.",
          "type": "string"
        },
        "path": {
          "description": "Asset file path relative to the project root. See `shadertoy docs assets` for cubemap and volume on-disk layouts.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "path"
      ]
    },
    "AssetKind": {
      "type": "string",
      "enum": [
        "texture",
        "cubemap",
        "volume",
        "video"
      ]
    },
    "Filter": {
      "type": "string",
      "enum": [
        "mipmap",
        "linear",
        "nearest"
      ]
    },
    "FrameRef": {
      "type": "string",
      "enum": [
        "current",
        "previous"
      ]
    },
    "Input": {
      "type": "object",
      "properties": {
        "channel": {
          "description": "Input channel index. Must be between 0 and 15.",
          "type": "integer",
          "format": "uint8",
          "maximum": 15,
          "minimum": 0
        },
        "filter": {
          "description": "Per-input texture interpolation/minification mode.\nnearest = exact texel sampling, linear = bilinear interpolation,\nmipmap = trilinear minification with linear magnification.",
          "$ref": "#/$defs/Filter",
          "default": "linear"
        },
        "frame": {
          "$ref": "#/$defs/FrameRef",
          "default": "current"
        },
        "kind": {
          "description": "Optional explicit source kind. Normally inferred from the source name.",
          "anyOf": [
            {
              "$ref": "#/$defs/InputKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "description": "Render-target index when consuming another pass. Output 0 is the primary target.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "description": "Pass/asset name, or the reserved names \"keyboard\" and \"music\".",
          "type": "string"
        },
        "wrap": {
          "description": "Per-input texture coordinate addressing mode.",
          "$ref": "#/$defs/Wrap",
          "default": "repeat"
        }
      },
      "additionalProperties": false,
      "required": [
        "channel",
        "source"
      ]
    },
    "InputKind": {
      "type": "string",
      "enum": [
        "pass",
        "texture",
        "cubemap",
        "volume",
        "keyboard",
        "music",
        "video",
        "webcam"
      ]
    },
    "Pass": {
      "type": "object",
      "properties": {
        "extra_outputs": {
          "description": "Additional render targets beyond output 0. Indices are 1-based after the primary format.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RenderFormat"
          }
        },
        "format": {
          "description": "Floating-point render-target format for buffer/compute outputs.",
          "$ref": "#/$defs/RenderFormat"
        },
        "height": {
          "description": "Optional fixed height for a buffer/compute pass. Must be paired with width.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Input"
          }
        },
        "iterations": {
          "description": "Number of compute dispatches per rendered frame. iIteration is 0-based.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/PassKind"
        },
        "local_size": {
          "description": "Compute local workgroup dimensions. Defaults to [8, 8, 1]; Z must be 1 for the 2D mainCompute entrypoint.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 3,
          "minItems": 3
        },
        "name": {
          "description": "Unique pass name. Names are used by inspect/render/debug commands.",
          "type": "string"
        },
        "source": {
          "description": "GLSL source path relative to the project root.",
          "type": "string"
        },
        "storage": {
          "description": "Persistent shader-storage buffers bound for this pass.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageBuffer"
          }
        },
        "width": {
          "description": "Optional fixed width for a buffer/compute pass. Must be paired with height.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "source"
      ]
    },
    "PassKind": {
      "type": "string",
      "enum": [
        "image",
        "buffer",
        "cubemap",
        "compute",
        "sound"
      ]
    },
    "Preset": {
      "type": "object",
      "properties": {
        "pass": {
          "description": "Overrides keyed by pass name, e.g. [preset.low.pass.surface].",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PresetPass"
          }
        },
        "render_scale": {
          "description": "Scale applied to the manifest's default output width/height.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "PresetPass": {
      "type": "object",
      "properties": {
        "height": {
          "description": "Fixed pass height override. Must be paired with width.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "iterations": {
          "description": "Compute dispatch count override.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "local_size": {
          "description": "Compute local workgroup override.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 3,
          "minItems": 3
        },
        "width": {
          "description": "Fixed pass width override. Must be paired with height.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ProjectSection": {
      "type": "object",
      "properties": {
        "author": {
          "description": "Original ShaderToy author, when this project was imported.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Original ShaderToy description, when this project was imported.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Human-readable project name.",
          "type": "string"
        },
        "source_id": {
          "description": "ShaderToy shader id for imported projects.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "description": "Canonical source URL for imported projects.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "RenderFormat": {
      "type": "string",
      "enum": [
        "r32f",
        "rg32f",
        "rgba16f",
        "rgba32f"
      ]
    },
    "RenderSection": {
      "type": "object",
      "properties": {
        "fps": {
          "description": "Fixed timestep frame rate used by deterministic rendering.",
          "type": "number",
          "format": "float",
          "default": 60.0
        },
        "height": {
          "description": "Default render/preview height in pixels.",
          "type": "integer",
          "format": "uint32",
          "default": 720,
          "minimum": 0
        },
        "preview_time": {
          "description": "Representative time used by `shadertoy render` when no frame/time is supplied.",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "width": {
          "description": "Default render/preview width in pixels.",
          "type": "integer",
          "format": "uint32",
          "default": 1280,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ShaderSection": {
      "type": "object",
      "properties": {
        "include_dirs": {
          "description": "Project-relative directories searched after the including file's directory for quoted #include paths.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "StorageBuffer": {
      "type": "object",
      "properties": {
        "binding": {
          "description": "Shader storage binding index used by an explicit std430 binding.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Shared resource name. Bindings with the same name share persistent GPU storage across passes.",
          "type": "string"
        },
        "size": {
          "description": "Persistent storage size in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "binding",
        "name",
        "size"
      ]
    },
    "TestCase": {
      "type": "object",
      "properties": {
        "assert_deterministic": {
          "description": "Re-run every matrix entry from a fresh runtime and require identical output.",
          "type": "boolean",
          "default": false
        },
        "assert_no_inf": {
          "type": "boolean",
          "default": false
        },
        "assert_no_nan": {
          "type": "boolean",
          "default": false
        },
        "assert_resolution_independent": {
          "description": "Require a fixed-size buffer/compute pass to be unchanged by output resolution.",
          "type": "boolean",
          "default": false
        },
        "assert_state_roundtrip": {
          "description": "Serialize persistent pass/SSBO state, reload it into a fresh runtime, and verify exact round-trip contents.",
          "type": "boolean",
          "default": false
        },
        "frame": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "frames": {
          "description": "Additional deterministic frames. Mutually exclusive with frame/time.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_gpu_ms": {
          "description": "Maximum summed attributed GPU pass time for each rendered test variant.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "max_pass_gpu_ms": {
          "description": "Per-pass GPU timing budgets in milliseconds.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "float"
          }
        },
        "max_rmse": {
          "description": "Maximum normalized RGB RMSE allowed against a reference image or reference uniforms.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "mean_range": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "min_rmse": {
          "description": "Minimum normalized RGB RMSE required against a reference image or reference uniforms.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "name": {
          "type": "string"
        },
        "pass": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_tolerance": {
          "description": "Absolute tolerance for raw floating-point comparisons.",
          "type": "number",
          "format": "float"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_uniforms": {
          "description": "Render a second deterministic variant with these uniforms and compare it with the primary uniforms.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/UniformValue"
          }
        },
        "resolutions": {
          "description": "Output-resolution matrix. Mutually exclusive with width/height.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "storage": {
          "description": "Exact SSBO fixture assertions evaluated after each rendered variant.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestStorageAssertion"
          }
        },
        "time": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "tolerance": {
          "type": "number",
          "format": "float",
          "default": 0.0020000000949949026
        },
        "uniforms": {
          "description": "Per-test custom uniform overrides.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/UniformValue"
          }
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "TestStorageAssertion": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Shared SSBO resource name.",
          "type": "string"
        },
        "reference": {
          "description": "Project-relative binary fixture compared byte-for-byte with the SSBO contents.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "reference"
      ]
    },
    "UniformDefinition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "number",
              "format": "float"
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "min": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "name": {
              "type": "string"
            },
            "step": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "default"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "integer",
              "format": "int32"
            },
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "min": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "name": {
              "type": "string"
            },
            "step": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "type": {
              "type": "string",
              "const": "int"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "default"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "bool"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "default"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "max": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "min": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "name": {
              "type": "string"
            },
            "step": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "vec2"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "default"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "max": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "min": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "name": {
              "type": "string"
            },
            "step": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "vec3"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "default"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "max": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "min": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "name": {
              "type": "string"
            },
            "step": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "vec4"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "default"
          ]
        }
      ]
    },
    "UniformValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int32"
        },
        {
          "type": "number",
          "format": "float"
        },
        {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 3,
          "minItems": 3
        },
        {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 4,
          "minItems": 4
        }
      ]
    },
    "Wrap": {
      "type": "string",
      "enum": [
        "clamp",
        "repeat"
      ]
    }
  }
}
